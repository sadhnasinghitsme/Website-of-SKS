# --- Enquiry form delivery (app/api/enquiry/route.ts) ---
# The lead form emails each enquiry via Resend (https://resend.com).
# Create an API key and verify a sending domain, then set:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Address that receives the enquiries (defaults to the school inbox below)
ENQUIRY_TO=contact@sksworldschoolnoida.ac.in

# Verified sender on your Resend domain, e.g. "SKS Admissions <admissions@your-domain.com>"
ENQUIRY_FROM=SKS World School <onboarding@resend.dev>

# Optional: comma-separated extra recipients (front-desk, counsellor, etc.)
# ENQUIRY_CC=

# If RESEND_API_KEY is not set the API route still returns 200 and logs the
# lead to the server console — handy for local development / preview builds.

# --- Backend REST API (lib/api.ts) ---
# Base URL of the Express/MongoDB backend in /backend. Include the /api suffix.
# Dev:  http://localhost:5000/api
# Prod: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
