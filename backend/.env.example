# ------------------------------------------------------------------
# SKS World School — backend environment
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/sks_school
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sks_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sks_school

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Admin API key — required in the `x-api-key` header for admin-only routes
# (POST /api/news, POST /api/achievements). Use a long random string.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Rate limiting (optional overrides)
# Window in minutes and max requests per window for public POST routes.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_POST=10
